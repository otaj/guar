# Total cost brace; booked per-unit cost is 100 USD on txn date.
directives {
  date { year: 2020 month: 1 day: 1 }
  open { account { name: "Assets:Shares" } }
}
directives {
  date { year: 2020 month: 1 day: 1 }
  open { account { name: "Assets:Cash" } }
}
directives {
  date { year: 2020 month: 3 day: 1 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "buy"
    postings {
      account { name: "Assets:Shares" }
      units { number { value: "10" } currency { name: "HOOL" } }
      cost {
        number { value: "100" }
        currency { name: "USD" }
        date { year: 2020 month: 3 day: 1 }
      }
    }
    postings {
      account { name: "Assets:Cash" }
      units { number { value: "-1000" } currency { name: "USD" } }
    }
  }
}
