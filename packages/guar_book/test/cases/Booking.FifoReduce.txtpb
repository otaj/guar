# FIFO reduction against a single matching lot.
directives {
  date { year: 2014 month: 2 day: 1 }
  open { account { name: "Assets:Investments:MSFT" } booking: BOOKING_FIFO }
}
directives {
  date { year: 2014 month: 2 day: 1 }
  open { account { name: "Assets:Cash" } }
}
directives {
  date { year: 2014 month: 2 day: 1 }
  open { account { name: "Income:Gains" } }
}
directives {
  date { year: 2014 month: 2 day: 10 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "buy"
    postings {
      account { name: "Assets:Investments:MSFT" }
      units { number { value: "10" } currency { name: "MSFT" } }
      cost {
        number { value: "100" }
        currency { name: "USD" }
        date { year: 2014 month: 2 day: 10 }
      }
    }
    postings {
      account { name: "Assets:Cash" }
      units { number { value: "-1000" } currency { name: "USD" } }
    }
  }
}
directives {
  date { year: 2014 month: 2 day: 20 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "sell fifo"
    postings {
      account { name: "Assets:Investments:MSFT" }
      units { number { value: "-5" } currency { name: "MSFT" } }
      cost {
        number { value: "100" }
        currency { name: "USD" }
        date { year: 2014 month: 2 day: 10 }
      }
    }
    postings {
      account { name: "Assets:Cash" }
      units { number { value: "550" } currency { name: "USD" } }
    }
    postings {
      account { name: "Income:Gains" }
      units { number { value: "-50" } currency { name: "USD" } }
    }
  }
}
