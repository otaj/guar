directives {
  date { year: 2014 month: 7 day: 11 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "Hello one line\nand yet another,\nand why not another!"
    postings {
      account { name: "Expenses:Restaurant" }
      units { number { verbatim: "100" resolved: "100" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:Cash" }
      units { number { verbatim: "-100" resolved: "-100" } currency { name: "USD" } }
    }
  }
}
