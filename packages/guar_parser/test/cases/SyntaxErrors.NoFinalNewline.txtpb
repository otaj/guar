# Parser now accepts EOF in place of final newline (fixed in #54)
directives {
  date { year: 2014 month: 11 day: 2 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    postings {
      account { name: "Assets:Something" }
      units { number { verbatim: "1" resolved: "1" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:Other" }
      units { number { verbatim: "-1" resolved: "-1" } currency { name: "USD" } }
    }
  }
}
