directives {
  date { year: 2013 month: 5 day: 18 }
  meta {
    entries { key: "string" value { text: "Something" } }
    entries { key: "account" value { account { name: "Assets:Investments:Cash" } } }
    entries { key: "date" value { date { year: 2012 month: 1 day: 1 } } }
    entries { key: "currency" value { currency { name: "HOOL" } } }
    entries { key: "tag" value { tag { name: "trip-florida" } } }
    entries { key: "number" value { number { verbatim: "345.67" resolved: "345.67" } } }
    entries { key: "amount" value { amount { number { verbatim: "345.67" resolved: "345.67" } currency { name: "USD" } } } }
    entries { key: "boolt" value { boolean: true } }
    entries { key: "boolf" value { boolean: false } }
  }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
  }
}
