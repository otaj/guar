# EolComment token handles indented comment at EOF
directives {
  date { year: 2013 month: 5 day: 18 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "Nice dinner at Mermaid Inn"
    postings {
      account { name: "Expenses:Restaurant" }
      units { number { verbatim: "100" resolved: "100" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:US:Cash" }
    }
  }
}
