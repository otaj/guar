      price { number { verbatim: "0" resolved: "0" } currency { name: "XFER" } }
    }
    postings {
      account { name: "Equity:Conversions" }
      units { number { verbatim: "101" resolved: "101" } currency { name: "CAD" } }
      price { number { verbatim: "0" resolved: "0" } currency { name: "XFER" } }
    }
    postings {
      account { name: "Equity:Conversions" }
      units { number { verbatim: "102" resolved: "102" } currency { name: "AUD" } }
      price { number { verbatim: "0" resolved: "0" } currency { name: "XFER" } }
    }
  }
}
