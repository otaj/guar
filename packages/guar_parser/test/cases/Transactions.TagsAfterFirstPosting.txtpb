# ANOMALY: Lima counts any metadata after a posting as associated with that posting
# which seems to match what is described at
# https://beancount.github.io/docs/beancount_language_syntax.html#metadata_1
# guar: same decision (tag/link lines after a posting attach as posting metadata)
directives {
  date { year: 2014 month: 4 day: 20 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "Links and tags on subsequent lines"
    tags { name: "basetag" }
    links { name: "baselink" }
    postings {
      meta {
        entries { value { tag { name: "tag1" } } }
      }
      account { name: "Assets:Checking" }
      units { number { verbatim: "100" resolved: "100" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:Checking" }
      units { number { verbatim: "-99" resolved: "-99" } currency { name: "USD" } }
    }
  }
}
