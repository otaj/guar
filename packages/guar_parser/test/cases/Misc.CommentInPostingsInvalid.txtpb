# ANOMALY: Lima parser is not sensitive to extra comment lines with unexpected indent
# guar: same decision (indented comments in postings are ignored)
directives {
  date { year: 2017 month: 6 day: 27 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "Bitcoin network fee"
    postings {
      account { name: "Expenses:Crypto:NetworkFees" }
      units { number { verbatim: "0.00082487" resolved: "0.00082487" } currency { name: "BTC" } }
    }
    postings {
      account { name: "Assets:Crypto:Bitcoin" }
      units { number { verbatim: "-0.00082487" resolved: "-0.00082487" } currency { name: "BTC" } }
    }
  }
}
