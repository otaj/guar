directives {
  date { year: 2014 month: 4 day: 20 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "Like a conversion entry"
    postings {
      account { name: "Assets:Investment" }
      units { number { verbatim: "10" resolved: "10" } currency { name: "HOOL" } }
      cost { number_per { verbatim: "0" resolved: "0" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:Cash" }
      units { number { verbatim: "0" resolved: "0" } currency { name: "USD" } }
    }
  }
}
