# ANOMALY: Lima returns directives in date order
# guar: same decision (directives are sorted by date)
directives {
  date { year: 2013 month: 1 day: 1 }
  open { account { name: "Equity:Other" } }
}
directives {
  date { year: 2013 month: 1 day: 1 }
  meta {
    entries { key: "test1" value { text: "Something" } }
    entries { key: "test2" value { text: "Something" } }
  }
  open { account { name: "Assets:Investments" } }
}
directives {
  date { year: 2013 month: 1 day: 10 }
  meta {
    entries { key: "test1" value { text: "Something" } }
  }
  note { account { name: "Assets:Investments" } comment: "Bla" }
}
directives {
  date { year: 2013 month: 1 day: 31 }
  meta {
    entries { key: "test1" value { text: "Something" } }
  }
  pad { account { name: "Assets:Investments" } source_account { name: "Equity:Other" } }
}
directives {
  date { year: 2013 month: 2 day: 1 }
  meta {
    entries { key: "test1" value { text: "Something" } }
  }
  balance { account { name: "Assets:Investments" } amount { number { verbatim: "111.00" resolved: "111.00" } currency { name: "USD" } } }
}
directives {
  date { year: 2013 month: 3 day: 1 }
  meta {
    entries { key: "test1" value { text: "Something" } }
  }
  document { account { name: "Assets:Investments" } filename: "/path/to/something.pdf" }
}
directives {
  date { year: 2013 month: 3 day: 1 }
  meta {
    entries { key: "test1" value { text: "Something" } }
  }
  price { currency { name: "HOOL" } amount { number { verbatim: "500" resolved: "500" } currency { name: "USD" } } }
}
directives {
  date { year: 2013 month: 3 day: 1 }
  meta {
    entries { key: "test1" value { text: "Something" } }
  }
  event { name: "location" description: "Nowhere" }
}
directives {
  date { year: 2014 month: 1 day: 1 }
  meta {
    entries { key: "test1" value { text: "Something" } }
  }
  close { account { name: "Assets:Investments" } }
}
