# ANOMALY: Lima does not allow duplicated keys for metadata.
# The explicit key/values for a directive take precedence over
# any on the push/pop stack.
# guar: same decision (explicit metadata overrides pushmeta)
directives {
  date { year: 2015 month: 6 day: 7 }
  meta {
    entries { key: "location" value { text: "Paris, France" } }
  }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "Something"
    postings {
      account { name: "Assets:Something" }
      units { number { verbatim: "1" resolved: "1" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:Something" }
      units { number { verbatim: "-1" resolved: "-1" } currency { name: "USD" } }
    }
  }
}
