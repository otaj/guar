directives {
  date { year: 2010 month: 5 day: 28 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    postings {
      account { name: "Assets:Account1" }
      units { number { verbatim: "100.00" resolved: "100.00" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:Account2" }
      units { number { verbatim: "-100.00" resolved: "-100.00" } currency { name: "USD" } }
    }
  }
}
