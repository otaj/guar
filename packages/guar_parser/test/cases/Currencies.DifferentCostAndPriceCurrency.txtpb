# ANOMALY: Lima parser doesn't check for matching currencies
# Should be done in post-processing
# guar: same decision (currency consistency is deferred past parse)
directives {
  date { year: 2018 month: 3 day: 21 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    narration: "Convert MR to KrisFlyer"
    postings {
      account { name: "Assets:Test" }
      units { number { verbatim: "-100" resolved: "-100" } currency { name: "MR" } }
      cost { number_per { verbatim: "0.0075" resolved: "0.0075" } currency { name: "USD" } }
      price { number { verbatim: "1" resolved: "1" } currency { name: "KRISFLYER" } }
    }
    postings {
      account { name: "Assets:Krisflyer" }
      units { number { verbatim: "100" resolved: "100" } currency { name: "KRISFLYER" } }
    }
  }
}
