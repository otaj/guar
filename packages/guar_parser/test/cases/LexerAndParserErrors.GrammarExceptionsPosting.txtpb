# ANOMALY: Lima returns directives in date order
# guar: same decision (directives are sorted by date)
directives {
  date { year: 2000 month: 1 day: 1 }
  open { account { name: "Assets:Before" } }
}
directives {
  date { year: 2010 month: 1 day: 1 }
  close { account { name: "Assets:Before" } }
}
directives {
  date { year: 2010 month: 1 day: 1 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    postings {
      account { name: "Assets:Before" }
      units { number { verbatim: "100.00" resolved: "100.00" } currency { name: "USD" } }
    }
    postings {
      account { name: "Assets:After" }
      units { number { verbatim: "-100.00" resolved: "-100.00" } currency { name: "USD" } }
    }
  }
}
