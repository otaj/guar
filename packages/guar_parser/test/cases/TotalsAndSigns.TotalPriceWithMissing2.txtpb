# ANOMALY: Lima parser does not validate totals against units, that is for post-processing
# guar: same decision (total/units consistency is deferred past parse)
directives {
  date { year: 2013 month: 5 day: 18 }
  transaction {
    flag { special: SPECIAL_FLAG_ASTERISK }
    postings {
      account { name: "Assets:Investments:MSFT" }
      units { currency { name: "MSFT" } }
      price { number { verbatim: "2000.00" resolved: "2000.00" } currency { name: "USD" } is_total: true }
    }
    postings {
      account { name: "Assets:Investments:Cash" }
      units { number { verbatim: "20000.00" resolved: "20000.00" } currency { name: "USD" } }
    }
  }
}
